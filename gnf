-- ── page layout engine ──────────────────────────────────────────────
-- Two columns per page. Each addSection() opens a new card and alternates
-- the column, which is what gives the reference its stacked-panel look.

local pageState = {}
local cardSeq = 0

local function relayout(ps)
	local heights = { 0, 0 }
	local counts = { 0, 0 }

	for _, rec in ipairs(ps.cards) do
		if rec.frame.Visible then
			local visible = 0
			for _, row in ipairs(rec.rows) do
				if row.frame.Visible then
					visible = visible + 1
				end
			end
			local bodyH = 0
			if visible > 0 then
				bodyH = BODY_PAD_T + BODY_PAD_B + visible * ROW_H + (visible - 1) * ROW_GAP
			end
			rec.body.Size = UDim2.new(1, 0, 0, bodyH)
			rec.frame.Size = UDim2.new(1, 0, 0, CARD_HEAD + bodyH)
			heights[rec.col] = heights[rec.col] + CARD_HEAD + bodyH + 8
			counts[rec.col] = counts[rec.col] + 1
		end
	end

	for i = 1, 2 do
		if counts[i] > 0 then
			heights[i] = heights[i] - 8
		end
	end

	-- a page with a single populated column stretches it to the full stage
	if counts[1] > 0 and counts[2] > 0 then
		ps.left.Position = UDim2.new(0, 0, 0, 0)
		ps.left.Size = UDim2.new(0.5, -COL_GAP / 2, 0, heights[1])
		ps.right.Position = UDim2.new(0.5, COL_GAP / 2, 0, 0)
		ps.right.Size = UDim2.new(0.5, -COL_GAP / 2, 0, heights[2])
	elseif counts[1] > 0 then
		ps.left.Position = UDim2.new(0, 0, 0, 0)
		ps.left.Size = UDim2.new(1, 0, 0, heights[1])
		ps.right.Position = UDim2.new(0.5, COL_GAP / 2, 0, 0)
		ps.right.Size = UDim2.new(0, 0, 0, 0)
	else
		ps.left.Position = UDim2.new(0, 0, 0, 0)
		ps.left.Size = UDim2.new(0, 0, 0, 0)
		ps.right.Position = UDim2.new(0, 0, 0, 0)
		ps.right.Size = UDim2.new(1, 0, 0, heights[2])
	end

	local tallest = math.max(heights[1], heights[2])
	ps.stage.Size = UDim2.new(1, -20, 0, tallest)
	ps.scroll.CanvasSize = UDim2.new(0, 0, 0, tallest + 18)
end

local function applySearch(query)
	query = string.lower(query or "")
	for _, ps in pairs(pageState) do
		for _, rec in ipairs(ps.cards) do
			local matched = false
			for _, row in ipairs(rec.rows) do
				local hit = (query == "") or (string.find(string.lower(row.label), query, 1, true) ~= nil)
				row.frame.Visible = hit
				if hit then
					matched = true
				end
			end
			rec.frame.Visible = matched or (#rec.rows == 0)
		end
		relayout(ps)
	end
end

local function makeCard(ps, header)
	local col = ps.side
	ps.side = (ps.side == 1) and 2 or 1
	cardSeq = cardSeq + 1

	local card = new("Frame", {
		Name = "Card",
		BackgroundColor3 = PAL.card,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, CARD_HEAD),
		LayoutOrder = cardSeq,
		Parent = (col == 1) and ps.left or ps.right,
	})
	round(4, card)
	ring(PAL.stroke, 1, card)

	local head = new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 0, CARD_HEAD),
		Font = FONT_B,
		TextSize = 10,
		TextColor3 = PAL.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = string.upper(header or "general"),
		Parent = card,
	})

	new("Frame", {
		BackgroundColor3 = PAL.stroke,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 0, CARD_HEAD - 1),
		Parent = card,
	})

	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, CARD_HEAD),
		Size = UDim2.new(1, 0, 0, 0),
		Parent = card,
	})
	pad(body, BODY_PAD_T, 10, BODY_PAD_B, 10)
	new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, ROW_GAP),
		Parent = body,
	})

	local rec = { frame = card, body = body, head = head, rows = {}, col = col }
	ps.cards[#ps.cards + 1] = rec
	ps.current = rec
	relayout(ps)
	return rec
end

local function hostRow(parent)
	local ps = pageState[parent]
	if not ps then
		return parent, nil, nil
	end
	if not ps.current then
		ps.current = makeCard(ps, "general")
	end
	return ps.current.body, ps.current, ps
end

local function track(ps, card, frame, label)
	if ps and card then
		card.rows[#card.rows + 1] = { frame = frame, label = label }
		relayout(ps)
	end
end

