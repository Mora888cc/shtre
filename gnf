local function hideESP(d)
	if not d then return end
	if d.box then d.box.Visible = false end
	if d.name then d.name.Visible = false end
	if d.healthBg then d.healthBg.Visible = false end
	if d.healthFill then d.healthFill.Visible = false end
	if d.distance then d.distance.Visible = false end
	if d.lines then
		for _, line in ipairs(d.lines) do
			line.Visible = false
		end
	end
end

local function updateESP()
	if not drawingOK then return end
	local cam = workspace.CurrentCamera
	if not cam then return end

	for _, plr in ipairs(Players:GetPlayers()) do
		local d = espData[plr]
		if isLocal(plr) or (Config.espTeamCheck and isTeammate(plr)) then
			hideESP(d)
		else
			local char, hum, root = alive(plr)
			if not char then
				hideESP(d)
			else
				local camPos = cam.CFrame.Position
				local distance = (camPos - root.Position).Magnitude
				if distance > Config.espMaxDistance then
					hideESP(d)
				else
					d = ensureESP(plr)
					if d then
						local cf, size = char:GetBoundingBox()
						local topWorld = (cf * CFrame.new(0, size.Y / 2, 0)).Position
						local bottomWorld = (cf * CFrame.new(0, -size.Y / 2, 0)).Position
						local topPos, topOn = cam:WorldToViewportPoint(topWorld)
						local bottomPos, bottomOn = cam:WorldToViewportPoint(bottomWorld)

						if topOn or bottomOn then
							local top2 = Vector2.new(topPos.X, topPos.Y)
							local bottom2 = Vector2.new(bottomPos.X, bottomPos.Y)
							local height = math.abs(bottom2.Y - top2.Y)
							local width = height * 0.55
							local left = top2.X - width / 2
							local boxTop = math.min(top2.Y, bottom2.Y)

							if Config.espBox then
								d.box.Visible = true
								d.box.Position = Vector2.new(left, boxTop)
								d.box.Size = Vector2.new(width, height)
							else
								d.box.Visible = false
							end

							if Config.espName then
								d.name.Visible = true
								d.name.Position = Vector2.new(top2.X, boxTop - 16)
								d.name.Text = plr.Name
							else
								d.name.Visible = false
							end

							if Config.espHealth and hum then
								local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
								d.healthBg.Visible = true
								d.healthBg.Position = Vector2.new(left - 6, boxTop)
								d.healthBg.Size = Vector2.new(3, height)

								d.healthFill.Visible = true
								d.healthFill.Position = Vector2.new(left - 6, boxTop + height * (1 - ratio))
								d.healthFill.Size = Vector2.new(3, height * ratio)
								d.healthFill.Color = Color3.fromRGB(
									math.floor(255 * (1 - ratio)),
									math.floor(255 * ratio),
									60
								)
							else
								d.healthBg.Visible = false
								d.healthFill.Visible = false
							end

							if Config.espDistance then
								d.distance.Visible = true
								d.distance.Position = Vector2.new(top2.X, boxTop + height + 2)
								d.distance.Text = math.floor(distance) .. "m"
							else
								d.distance.Visible = false
							end

							if Config.espSkeleton then
								local rigType = char:FindFirstChild("Humanoid") and char.Humanoid.RigType
								local pairsList
								if rigType == Enum.HumanoidRigType.R15 then
									pairsList = skeletonPairs.R15
								else
									pairsList = skeletonPairs.R6
								end

								for i, line in ipairs(d.lines) do
									local pair = pairsList[i]
									if pair then
										local a = char:FindFirstChild(pair[1])
										local b = char:FindFirstChild(pair[2])
										if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
											local pa, oa = cam:WorldToViewportPoint(a.Position)
											local pb, ob = cam:WorldToViewportPoint(b.Position)
											if oa and ob then
												line.Visible = true
												line.From = Vector2.new(pa.X, pa.Y)
												line.To = Vector2.new(pb.X, pb.Y)
											else
												line.Visible = false
											end
										else
											line.Visible = false
										end
									else
										line.Visible = false
									end
								end
							else
								for _, line in ipairs(d.lines) do
									line.Visible = false
								end
							end
						else
							hideESP(d)
						end
					end
				end
			end
		end
	end
end

