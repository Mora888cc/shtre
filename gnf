local function addSlider(parent, label, key, min, max, step, callback)
	local host, card, ps = hostRow(parent)
	local row, text = makeRow(host, label, false)
	text.TextColor3 = PAL.text

	local box = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -2, 0.5, 0),
		Size = UDim2.fromOffset(84, 15),
		BackgroundColor3 = PAL.sunken,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	round(3, box)
	local boxRing = ring(PAL.stroke, 1, box)

	local clip = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		BorderSizePixel = 0,
		Parent = box,
	})
	round(3, clip)

	local fill = new("Frame", {
		BackgroundColor3 = PAL.accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
		Parent = clip,
	})

	local value = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = FONT_M,
		TextSize = 10,
		TextColor3 = PAL.text,
		Text = "",
		Parent = box,
	})

	local function fmt(v)
		if step and step >= 1 then
			return tostring(math.floor(v + 0.5))
		end
		return string.format("%.2f", v)
	end

	local dragging = false

	local function setFromX(x)
		local width = math.max(box.AbsoluteSize.X, 1)
		local rel = math.clamp((x - box.AbsolutePosition.X) / width, 0, 1)
		local raw = min + (max - min) * rel
		if step and step > 0 then
			raw = math.floor(raw / step + 0.5) * step
		end
		raw = math.clamp(raw, min, max)
		Config[key] = raw
		fill.Size = UDim2.new(rel, 0, 1, 0)
		value.Text = fmt(raw)
		if callback then
			callback(raw)
		end
	end

	local function refresh()
		local v = tonumber(Config[key]) or min
		local rel = (max > min) and math.clamp((v - min) / (max - min), 0, 1) or 0
		fill.Size = UDim2.new(rel, 0, 1, 0)
		value.Text = fmt(v)
	end

	refresh()

	box.MouseEnter:Connect(function()
		boxRing.Color = PAL.strokeHi
	end)
	box.MouseLeave:Connect(function()
		boxRing.Color = PAL.stroke
	end)

	box.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	track(ps, card, row, label)
	return row
end

